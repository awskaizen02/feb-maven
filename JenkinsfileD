pipeline {
    agent any


    stages {
        stage('CODE') {
            steps {
                git branch: 'd1', url: 'https://github.com/awskaizen02/feb-maven.git'
            }
        }
    stage('Build') {
            steps {
                sh 'mvn clean'
		        sh 'mvn install'
            }
        }

	stage('Build Docker Image'){
     		steps{
		   script{
             		app = docker.build("dockerpandian/juneweb")
			app.inside {
				sh'echo$(curl localhost:8080)'	
			           }
				}
			}
					}
stage('Push Docker Image to Docker hub'){
	steps{
		script{
			docker.withRegistry('https://registry.hub.docker.com', 'DD'){
			app.push("${env.BUILD_NUMER}")
			app.push("latest")
					  }
			}
		}
							}
    }
}
