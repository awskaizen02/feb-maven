pipeline {
    agent any
   

    stages {
        stage('SCM') {
            steps {
                git branch: 'war', url: 'https://github.com/awskaizen02/feb-maven.git'
            }
        }
       stage('build') {
            steps {
                sh 'mvn clean'
                sh 'mvn install'
            }
        }
       stage('Build Docker Image') {
            steps {
                script{
			app = docker.build("dockerpandian/jweb")
			app.inside {
				sh'echo $(curl localhost:8080)'
		}
	}
            }
        }


       }

    }
